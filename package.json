{
  "name": "data-oriented-solver-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "docs:dev": "node tools/docs/assets.mjs && astro dev --root docs",
    "docs:build": "node tools/docs/assets.mjs && astro build --root docs",
    "docs:preview": "astro preview --root docs"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.13",
    "katex": "0.19.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
